<div type="{{config.props.type}}" size="{{config.props.size}}" {{#if config.style }} style="{{style config.style}}"
  {{/if}}>
  {{#each elements as |c|}}
  {{#if (eq c.type "Input")}}
  {{> qwikpageinput config=c.config }}
  {{/if}}

  {{#if (eq c.type "Button")}}
  {{> qwikpagebutton config=c.config }}
  {{/if}}
  {{/each}}
</div>