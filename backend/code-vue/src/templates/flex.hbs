<a-flex
  v-bind="$attrs"
  id="{{id}}"
  :vertical="{{config.props.vertical}}"
  wrap="{{config.props.wrap}}"
  justify="{{config.props.justify}}"
  align="{{config.props.align}}"
  :gap="{{config.props.gap}}"
  {{#if config.style }}style="{{style config.style}}"{{/if}}
>
  {{#each elements as |c|}}
  {{#if (eq c.type "Form")}}
  {{> qwikpageform id=c.id elements=c.elements config=c.config methods=c.methods events=c.events }}
  {{/if}}
  {{#if (eq c.type "Input")}}
  {{> qwikpageinput id=c.id config=c.config }}
  {{/if}}

  {{#if (eq c.type "CheckBox")}}
  {{> qwikpagecheckbox id=c.id config=c.config methods=c.methods events=c.events }}
  {{/if}}
  
  {{#if (eq c.type "Button")}}
  {{> qwikpagebutton id=c.id config=c.config methods=c.methods events=c.events }}
  {{/if}}
  {{/each}}
</a-flex>