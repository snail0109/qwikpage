<a-form
  ref="formRef"
  :model="formData"
  id="{{id}}"
  layout="{{config.props.layout}}"
  {{#if config.props.size}}size="{{config.props.size}}"{{/if}}
  label-align="{{config.props.labelAlign}}"
  {{#if config.props.labelCol}}:label-col="{{objToProps config.props.labelCol}}"{{/if}}
  {{#if config.props.wrapperCol}}:wrapper-col="{{objToProps config.props.wrapperCol}}"{{/if}}
  style="{{style config.style}}"
  @finish.prevent="handleFormSubmit"
>
  {{#each elements as |c|}}

  {{#if (eq c.type "Form")}}
  {{> qwikpageform id=c.id elements=c.elements config=c.config methods=c.methods events=c.events }}
  {{/if}}

  {{#if (eq c.type "Flex")}}
  {{> qwikpageflex id=c.id elements=c.elements config=c.config methods=c.methods events=c.events }}
  {{/if}}

  {{#if (eq c.type "Input")}}
  {{> qwikpageinput id=c.id config=c.config }}
  {{/if}}

  {{#if (eq c.type "CheckBox")}}
  {{> qwikpagecheckbox id=c.id config=c.config methods=c.methods events=c.events }}
  {{/if}}

  {{#if (eq c.type "Button")}}
  {{> qwikpagebutton id=c.id config=c.config methods=c.methods events=c.events }}
  {{/if}}

  {{/each}}
</a-form>