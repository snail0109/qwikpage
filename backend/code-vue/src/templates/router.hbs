import { createRouter, createWebHistory } from 'vue-router';
import NotFound from '@/views/NotFound.vue';
{{#each routes}}
import {{this.name}} from '{{this.component_path}}';
{{/each}}

const router = createRouter({
  history: createWebHistory(),
  routes: [
    { 
      path: '/:pathMatch(.*)*', 
      name: 'NotFound', 
      component: NotFound 
    },
    {{#each routes}}
    { 
      path: '{{this.path}}', 
      name: '{{this.name}}', 
      component: {{this.name}} 
    },
    {{/each}}
  ]
})

export default router;