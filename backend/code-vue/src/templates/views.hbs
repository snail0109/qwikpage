<template>
  {{#each components as |t|}}
    {{#if (eq t.type "Form")}}
      <!-- 表单容器特殊处理 -->
    <el-form ref="formRef" :model="formData" label-position="{{config.props.labelAlign}}"
      label-width="{{config.props.labelCol.span}}px" style="{{style config.style}}" @submit.prevent="handleFormSubmit"
      @reset.prevent="handleFormReset">
      {{#each t.elements as |c|}}
      <el-form-item label="{{config.props.formItem.label}}" prop="{{config.props.formItem.name}}">
        {{#if (eq c.type "Input")}}
        {{> qwikpageinput config=c.config }}
        {{/if}}
       </el-form-item>
      {{/each}}
    </el-form>
    {{/if}}
    {{#if (eq t.type "Flex")}}
    <!-- Flex -->
    {{> qwikpageflex elements=t.elements config=t.config methods=t.methods events=t.events }}
    {{/if}}
    {{#if (eq t.type "Input")}}
    <!-- 输入框组件 -->
    {{> qwikpageinput config=t.config }}
    {{/if}}
    {{#if (eq t.type "Button")}}
    <!-- 按钮组件 -->
    {{> qwikpagebutton config=t.config methods=t.methods events=t.events }}
    {{/if}}
    {{#if (eq t.type "CheckBox")}}
    <!-- CheckBox -->
    {{> qwikpagecheckbox config=t.config methods=t.methods events=t.events }}
    {{/if}}
  {{/each}}
</template>

<script>
  import { ref } from 'vue'

  export default {
    name: 'ComponentRenderer',
    props: {
      components: {
        type: Array,
        required: true
      }
    },
    setup() {
      const formData = ref({})
      const formRef = ref(null)

      const handleEvent = (eventType, component) => {
        console.log('Event triggered:', eventType, component.id)
        if (eventType === 'onFinish') {
          formRef.value?.validate(valid => {
            if (valid) {
              console.log('Submit data:', formData.value)
            }
          })
        }
      }

      return {
        formData,
        formRef,
        handleEvent
      }
    }
  }
</script>