<template>
  {{#each components as |t|}}
    {{#if (eq t.type "Form")}}
      <!-- Form -->
    {{> qwikpageform id=t.id elements=t.elements config=t.config methods=t.methods events=t.events }}
    {{/if}}
    {{#if (eq t.type "Flex")}}
    <!-- Flex -->
    {{> qwikpageflex id=t.id elements=t.elements config=t.config methods=t.methods events=t.events }}
    {{/if}}
    {{#if (eq t.type "Input")}}
    <!-- 输入框组件 -->
    {{> qwikpageinput id=t.id config=t.config }}
    {{/if}}
    {{#if (eq t.type "Button")}}
    <!-- 按钮组件 -->
    {{> qwikpagebutton id=t.id config=t.config methods=t.methods events=t.events }}
    {{/if}}
    {{#if (eq t.type "CheckBox")}}
    <!-- CheckBox -->
    {{> qwikpagecheckbox id=t.id config=t.config methods=t.methods events=t.events }}
    {{/if}}
  {{/each}}
</template>

<script>
  import { ref } from 'vue'

  export default {
    name: 'ComponentRenderer',
    props: {
      components: {
        type: Array,
        required: true
      }
    },
    setup() {
      const formData = ref({})
      const formRef = ref(null)

      const handleEvent = (eventType, component) => {
        console.log('Event triggered:', eventType, component.id)
        if (eventType === 'onFinish') {
          formRef.value?.validate(valid => {
            if (valid) {
              console.log('Submit data:', formData.value)
            }
          })
        }
      }

      const handleFormSubmit = (values) => {
        console.log('Form Submit Success:', values);
      }

      return {
        formData,
        formRef,
        handleEvent,
        handleFormSubmit,
      }
    }
  }
</script>