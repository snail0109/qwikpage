<a-input
  v-bind="$attrs"
  id="{{id}}"
  {{#if config.props.formItem.name}}v-model="formData.{{config.props.formItem.name}}"{{/if}}
  placeholder="{{config.props.formWrap.placeholder}}"
  :clearable="{{config.props.formWrap.allowClear}}"
  {{#if config.style}}style="{{style config.style}}"{{/if}}
/>